# App
APP_NAME=Intelligent Bug Diagnosis Platform
ENVIRONMENT=development
DEBUG=true

# Mongo
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=bug_diagnosis_ai

# Comma-separated emails that become admin automatically on registration
ADMIN_EMAILS=admin@example.com

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.py,.java,.js,.ts,.jsx,.tsx,.zip,.log,.txt,.pdf,.docx,.md

# RAG
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
KNOWLEDGE_BASE_DIR=knowledge_base

# LLM provider: "groq" or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
